{
  "name": "Mukasa Moses Bwesige website",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "postCreateCommand": "python -m pip install -r requirements.txt && python manage.py migrate",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Django development server",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
